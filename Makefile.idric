# Explicit tools; no Java/Kotlin source generation or application Gradle stage.
ROOT := $(CURDIR)
APP_SOURCE_COMMIT ?= $(shell git rev-parse HEAD)
IDRIC_REPO ?= $(ROOT)/../Idric
DEX_REPO ?= $(ROOT)/../idric-arm-thumb
MANAGED_DEX_REPO ?= $(ANDROID_NDK_REPO)
ANDROID_NDK_REPO ?= $(ROOT)/../android-NDK
AICI_REPO ?= $(ROOT)/../ai-ci
IDRIC ?= $(IDRIC_REPO)/_/build/exec/idris2
NDK ?= $(ANDROID_HOME)/ndk/29.0.14206865
LEGACY_NDK ?= $(ANDROID_HOME)/ndk/25.2.9519653
LUA_SOURCE ?= $(ROOT)/../lua-5.4.8/src
HOST_CLANG := $(NDK)/toolchains/llvm/prebuilt/linux-x86_64/bin/clang
CORE := examples/autogenerated/chordreader
SUPPORT := $(IDRIC_REPO)/_/build/exec/idris2_app/libidris2_support.so
export IDRIS2_INC_CGS := chez
export CHEZ ?= $(IDRIC_REPO)/_/.tools/bin/scheme
export PATH := $(IDRIC_REPO)/_/.tools/bin:$(IDRIC_REPO)/_/.tools/chez-10.4.1/bin:$(PATH)
export LD_LIBRARY_PATH := $(dir $(SUPPORT)):$(LD_LIBRARY_PATH)

.PHONY: test policy typecheck-control core-test comparisons dex callback assets native-arm32 native-arm64 native-emulator package acceptance-driver emulator-check
test: policy frontend-controls typecheck-control core-test comparisons

frontend-controls:
	$(IDRIC) --source-dir $(IDRIC_REPO)/_/tests/idris2/basic/edric012 $(IDRIC_REPO)/_/tests/idris2/basic/edric012/Main.idric -o unicode-minus-control
	cp "$(SUPPORT)" build/exec/unicode-minus-control_app/
	./build/exec/unicode-minus-control > build/exec/unicode-minus-control.txt
	$(IDRIC) --source-dir $(IDRIC_REPO)/_/tests/idris2/basic/edric012 $(IDRIC_REPO)/_/tests/idris2/basic/edric012/Compatibility.idr -o unicode-compatibility-control
	cp "$(SUPPORT)" build/exec/unicode-compatibility-control_app/
	./build/exec/unicode-compatibility-control >> build/exec/unicode-minus-control.txt
	cmp $(IDRIC_REPO)/_/tests/idris2/basic/edric012/expected build/exec/unicode-minus-control.txt
	$(IDRIC) -p network -p idris2 --source-dir $(IDRIC_REPO)/examples/autogenerated/codegen-error-exit $(IDRIC_REPO)/examples/autogenerated/codegen-error-exit/Driver.idric -o codegen-error-control
	cp "$(SUPPORT)" build/exec/codegen-error-control_app/
	! ./build/exec/codegen-error-control --cg rejecting-fixture --source-dir $(IDRIC_REPO)/examples/autogenerated/codegen-error-exit $(IDRIC_REPO)/examples/autogenerated/codegen-error-exit/Input.idric -o refused-generator > build/exec/codegen-error-control.txt 2>&1
	rg -F 'deliberate code-generator failure' build/exec/codegen-error-control.txt
	test ! -e build/exec/refused-generator

policy:
	mkdir -p build/exec
	$(HOST_CLANG) --target=x86_64-linux-gnu -std=c17 -O2 -Wall -Wextra -Werror "$(AICI_REPO)/src/aici.c" -o build/exec/aici
	./build/exec/aici verify "$(AICI_REPO)/contracts/build-toolchain-v0.contract.tsv" "$(ROOT)"

typecheck-control:
	mkdir -p build/exec
	! $(IDRIC) -Werror --check --source-dir $(CORE)/typechecking $(CORE)/typechecking/RejectBroken.idric > build/exec/rejected-source.txt 2>&1
	rg -F 'FromString Int32' build/exec/rejected-source.txt

core-test:
	$(IDRIC) -Werror --check -p contrib --source-dir $(CORE) $(CORE)/Main.idric
	$(IDRIC) -Werror -p contrib --source-dir $(CORE) $(CORE)/Main.idric -o chordreader-tests
	cp "$(SUPPORT)" build/exec/chordreader-tests_app/
	./build/exec/chordreader-tests

build/exec/lua-host:
	mkdir -p build/exec
	$(HOST_CLANG) --target=x86_64-linux-gnu -O2 -DLUA_USE_LINUX \
		$(filter-out $(LUA_SOURCE)/luac.c,$(wildcard $(LUA_SOURCE)/*.c)) -ldl -lm -o $@

comparisons: build/exec/lua-host
	$(IDRIC) -Werror --check -p contrib --source-dir $(CORE) $(CORE)/RegressionRows.idric
	$(IDRIC) -Werror -p contrib --source-dir $(CORE) $(CORE)/RegressionRows.idric -o regression-rows
	cp "$(SUPPORT)" build/exec/regression-rows_app/
	./build/exec/regression-rows > build/exec/music-regressions.tsv
	./build/exec/lua-host "$(ROOT)/contingency/regression-test.lua" build/exec/music-regressions.tsv
	$(IDRIC) -Werror --check -p contrib --source-dir $(CORE) $(CORE)/RuntimeRows.idric
	$(IDRIC) -Werror -p contrib --source-dir $(CORE) $(CORE)/RuntimeRows.idric -o runtime-rows
	cp "$(SUPPORT)" build/exec/runtime-rows_app/
	./build/exec/runtime-rows > build/exec/pitch-rows.tsv
	./build/exec/runtime-rows library > build/exec/library-fixture.txt
	./build/exec/lua-host contingency/application-test.lua "$(ROOT)" build/exec/pitch-rows.tsv build/exec/library-fixture.txt
	$(IDRIC) -Werror --check --source-dir $(CORE) $(CORE)/KeyRows.idric
	$(IDRIC) -Werror --source-dir $(CORE) $(CORE)/KeyRows.idric -o key-rows
	cp "$(SUPPORT)" build/exec/key-rows_app/
	./build/exec/key-rows > build/exec/key-regressions.tsv
	./build/exec/lua-host contingency/key-regression-test.lua "$(ROOT)" build/exec/key-regressions.tsv

dex:
	$(MAKE) -C "$(MANAGED_DEX_REPO)/dex/idric" driver IDRIC="$(IDRIC)"
	IDRIS2_PATH="$(MANAGED_DEX_REPO)/dex/idric/build/ttc" "$(MANAGED_DEX_REPO)/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports -p contrib --source-dir "$(ROOT)/$(CORE)" --output-dir "$(ROOT)/build/exec" "$(ROOT)/$(CORE)/ManagedCore.idric" -o chordreader-pitch
	test -s build/exec/chordreader-pitch.dex
	test -s build/exec/chordreader-pitch.checked.anf
	IDRIS2_PATH="$(MANAGED_DEX_REPO)/dex/idric/build/ttc" "$(MANAGED_DEX_REPO)/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports -p contrib --source-dir "$(ROOT)/$(CORE)" --output-dir "$(ROOT)/build/exec" "$(ROOT)/$(CORE)/ManagedCore.idric" -o chordreader-repeat
	cmp build/exec/chordreader-pitch.dex build/exec/chordreader-repeat.dex
	$(MAKE) -C "$(DEX_REPO)" build/oracles/baksmali-3.0.10.jar
	java -jar "$(DEX_REPO)/build/oracles/baksmali-3.0.10.jar" disassemble build/exec/chordreader-pitch.dex -o build/exec/managed-decoded
	rg -F '.method public static application_request(Ljava/lang/String;)Ljava/lang/String;' build/exec/managed-decoded/Idric/Generated.smali
	rg -F '.method public static pitch_up(I)I' build/exec/managed-decoded/Idric/Generated.smali
	mkdir -p build/managed-mutant-source
	cp $(CORE)/*.idric build/managed-mutant-source/
	sed 's/note.accidental + interval.semitone_steps/note.accidental + 0/' $(CORE)/Music.idric > build/managed-mutant-source/Music.idric
	! cmp -s $(CORE)/Music.idric build/managed-mutant-source/Music.idric
	rg -F 'absolute_pitch = letter_pitch note.letter + note.accidental + 0' build/managed-mutant-source/Music.idric
	IDRIS2_PATH="$(MANAGED_DEX_REPO)/dex/idric/build/ttc" "$(MANAGED_DEX_REPO)/dex/idric/build/exec/idric-dex" --cg dex --directive managed-exports -p contrib --source-dir "$(ROOT)/build/managed-mutant-source" --build-dir "$(ROOT)/build/managed-mutant-check" --output-dir "$(ROOT)/build/exec" "$(ROOT)/build/managed-mutant-source/ManagedCore.idric" -o chordreader-mutant
	test -s build/exec/chordreader-mutant.dex
	! cmp -s build/exec/chordreader-pitch.dex build/exec/chordreader-mutant.dex

callback:
	$(MAKE) -C "$(DEX_REPO)" driver IDRIC="$(IDRIC)"
	IDRIS2_PATH="$(DEX_REPO)/build/ttc" $(IDRIC) --source-dir "$(ANDROID_NDK_REPO)/examples/autogenerated/native-view-callback" "$(ANDROID_NDK_REPO)/examples/autogenerated/native-view-callback/ClickListener.idric" -o native-view-callback
	cp "$(SUPPORT)" build/exec/native-view-callback_app/
	./build/exec/native-view-callback build/exec/native-listener.dex
	$(MAKE) -C "$(DEX_REPO)" build/oracles/baksmali-3.0.10.jar

acceptance-driver:
	IDRIS2_INC_CGS= $(IDRIC) -Werror --check -p contrib --source-dir $(CORE) $(CORE)/AndroidAcceptance.idric
	IDRIS2_INC_CGS= $(IDRIC) -Werror -p contrib --source-dir $(CORE) $(CORE)/AndroidAcceptance.idric -o android-acceptance
	cp "$(SUPPORT)" build/exec/android-acceptance_app/
	./build/exec/android-acceptance --self-test
	$(MAKE) -C "$(DEX_REPO)" build/oracles/smali-3.0.10.jar
	java -jar "$(DEX_REPO)/build/oracles/smali-3.0.10.jar" assemble $(CORE)/runtime -o build/exec/chordreader-runner.dex

ADB ?= $(ANDROID_HOME)/platform-tools/adb
ANDROID_SERIAL ?= emulator-5554
ACCEPTANCE_NONCE ?= local
BASELINE_APK ?= $(ROOT)/build/baseline/android/chordreader-x86_64.apk
ACCEPTANCE_RUN_DIR := $(ROOT)/build/acceptance-run/$(ACCEPTANCE_NONCE)
emulator-check:
	mkdir -p build/acceptance-run
	mkdir "$(ACCEPTANCE_RUN_DIR)"
	cp build/exec/android-acceptance "$(ACCEPTANCE_RUN_DIR)/"
	cp -R build/exec/android-acceptance_app "$(ACCEPTANCE_RUN_DIR)/"
	cp build/android/chordreader-x86_64.apk "$(ACCEPTANCE_RUN_DIR)/candidate.apk"
	cp "$(BASELINE_APK)" "$(ACCEPTANCE_RUN_DIR)/baseline.apk"
	cp build/exec/chordreader-pitch.dex build/exec/chordreader-mutant.dex build/exec/chordreader-runner.dex "$(ACCEPTANCE_RUN_DIR)/"
	rm -f build/exec/android-emulator.receipt.tsv
	"$(ACCEPTANCE_RUN_DIR)/android-acceptance" "$(ADB)" "$(ANDROID_SERIAL)" "$(ACCEPTANCE_RUN_DIR)/candidate.apk" "$(ACCEPTANCE_RUN_DIR)/chordreader-pitch.dex" "$(ACCEPTANCE_RUN_DIR)/chordreader-mutant.dex" "$(ACCEPTANCE_RUN_DIR)/chordreader-runner.dex" "$(ACCEPTANCE_NONCE)" "$(ACCEPTANCE_RUN_DIR)/baseline.apk"
	cp build/exec/android-emulator.receipt.tsv "$(ACCEPTANCE_RUN_DIR)/"

assets: dex callback
	mkdir -p build/android/assets build/android/res
	$(IDRIC) -Werror -p contrib --source-dir $(CORE) $(CORE)/DictionaryAssets.idric -o dictionary-assets
	cp "$(SUPPORT)" build/exec/dictionary-assets_app/
	./build/exec/dictionary-assets app/src/main/res/raw/guitar_chords.json app/src/main/res/raw/ukulele_chords.json build/android/assets/guitar-index.tsv build/android/assets/ukulele-index.tsv
	sha256sum app/src/main/res/raw/guitar_chords.json app/src/main/res/raw/ukulele_chords.json build/android/assets/guitar-index.tsv build/android/assets/ukulele-index.tsv > build/exec/dictionary-index.sha256
	cp contingency/app.lua contingency/json.lua build/android/assets/
	cp contingency/managed-music.lua build/android/assets/music.lua
	cp app/src/main/res/raw/guitar_chords.json app/src/main/res/raw/ukulele_chords.json build/android/assets/
	cp app/src/main/res/raw/about_body_*.htm LICENSE* build/android/assets/
	cp "$(LUA_SOURCE)/lua.h" build/android/assets/lua-license-and-interface.h
	cp build/exec/chordreader-pitch.dex build/android/assets/
	cp -R app/src/main/res/mipmap-* build/android/res/
	cp -R app/src/main/res/values app/src/main/res/values-de app/src/main/res/values-es app/src/main/res/values-fr build/android/assets/

native-arm32:
	$(MAKE) -C android-native NDK="$(NDK)" SYSROOT="$(LEGACY_NDK)/toolchains/llvm/prebuilt/linux-x86_64/sysroot" LUA_SOURCE="$(LUA_SOURCE)" TARGET=armv7a-linux-androideabi19 ABI=armeabi-v7a
native-arm64:
	$(MAKE) -C android-native NDK="$(NDK)" LUA_SOURCE="$(LUA_SOURCE)" TARGET=aarch64-linux-android21 ABI=arm64-v8a
native-emulator:
	$(MAKE) -C android-native NDK="$(NDK)" LUA_SOURCE="$(LUA_SOURCE)" TARGET=x86_64-linux-android29 ABI=x86_64

# Signing inputs must be supplied explicitly. The shared packager enforces
# identity, min/target API, native/DEX digests and final APK signatures.
ABI ?= armeabi-v7a
ANDROID_MIN_SDK ?= 19
package:
	ANDROID_SOURCE_COMMIT="$(APP_SOURCE_COMMIT)" ANDROID_PACKAGE_ID=org.isomorphisms.chordreader.dev ANDROID_VERSION_CODE=1002 ANDROID_VERSION_NAME=0.2-dev ANDROID_MIN_SDK=$(ANDROID_MIN_SDK) ANDROID_TARGET_SDK=36 ANDROID_REQUIRE_NO_DEX=0 ANDROID_ACTIVITY_CLASS=org.isomorphisms.NativeViewActivity ANDROID_BAKSMALI_JAR="$(DEX_REPO)/build/oracles/baksmali-3.0.10.jar" ANDROID_DEX_FILE="$(ROOT)/build/exec/native-listener.dex" ANDROID_RES_DIR="$(ROOT)/build/android/res" ANDROID_ASSET_DIR="$(ROOT)/build/android/assets" bash "$(ANDROID_NDK_REPO)/apk/build-nativeactivity-apk.sh" android-native/AndroidManifest.xml build/android/$(ABI)/libchordreader.so $(ABI) build/android/chordreader-$(ABI).apk
